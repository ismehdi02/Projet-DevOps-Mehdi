pipeline {
  agent any

  tools {
    maven 'Maven_3'
  }

  stages {
    stage('Checkout') {
      steps {
        checkout scm
      }
    }

    stage('Build') {
      steps {
        sh 'mvn -version'
        sh 'mvn -B clean package'
      }
    }

    stage('Test') {
      steps {
        sh 'mvn -B test'
      }
    }
  }
}
